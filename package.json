{
  "name": "social-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Local stdio MCP server that publishes to YouTube, Instagram, and X.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "due": "node dist/runner.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts && npm run build && node --test --test-concurrency=1 test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meabhisingh/social-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
