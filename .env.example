# Copy to .env and fill in values from each platform's developer console.
# Leave a variable unset if you are not using that platform.
# Never commit .env. The server reads process environment only.

# Local store. JSON records and retained media live here. Default: ./data
SOCIAL_MCP_DATA_DIR=

# Runner watch interval in milliseconds (minimum 5000). Default: 30000
SOCIAL_MCP_POLL_MS=

# YouTube Data API v3. Set an access token, or the three refresh values.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Graph API content publishing.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Optional. Default v22.0. Hostname only, no scheme.
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_GRAPH_HOST=
# Optional. How long to wait for a container to become FINISHED. Default 180000.
INSTAGRAM_STATUS_TIMEOUT_MS=

# X API v2. User-context OAuth 2.0 token (tweet.write and media.write).
X_OAUTH2_ACCESS_TOKEN=
# Or OAuth 1.0a user context, used when X_OAUTH2_ACCESS_TOKEN is unset.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
